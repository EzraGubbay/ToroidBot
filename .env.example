# Add the API key(s) for whichever provider you use.
# The model is selected via CLI flag or MODEL env var (e.g., "google-gla:gemini-2.5-flash").

# GEMINI_API_KEY=your-gemini-key       # required for google-gla:* models AND for RAG embeddings
# OPENAI_API_KEY=your-openai-key        # required only for openai:* models
# ANTHROPIC_API_KEY=your-anthropic-key  # required only for anthropic:* models
# OPENROUTER_API_KEY=your-openrouter-key  # required only for openrouter:* models

# Default model for all agents (override per-agent with --architect-model, etc.)
# MODEL=google-gla:gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=vectordb
DB_HOST=localhost
DB_PORT=5432

PGADMIN_EMAIL=admin@toroid.ai
PGADMIN_PASSWORD=admin123
